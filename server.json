{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.urlpipe/mcp",
  "title": "URLpipe",
  "description": "Read any page with its JavaScript run: Markdown, screenshots, metadata, console errors, Lighthouse.",
  "version": "1.1.0",
  "websiteUrl": "https://urlpipe.dev/mcp-server",
  "repository": {
    "url": "https://github.com/URLpipe/mcp",
    "source": "github",
    "id": "1386325850"
  },
  "icons": [
    { "src": "https://urlpipe.dev/icon.svg", "mimeType": "image/svg+xml", "sizes": ["any"] },
    { "src": "https://urlpipe.dev/icon.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://urlpipe.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer followed by a URLpipe organization token, created under Organization → MCP access at https://urlpipe.dev",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "value": "Bearer {token}",
          "variables": {
            "token": {
              "description": "A URLpipe organization token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
